# Скопируйте этот файл в .env и заполните значения.
# Файл .env добавлен в .gitignore и не попадает в репозиторий.

# Обязательный секрет приложения (сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))")
CRM_SECRET_KEY=

# Токен для общения CRM с Outlook-агентом (должен совпадать в обоих местах)
OUTLOOK_AGENT_TOKEN=

# Необязательные настройки
# CHECKO_HEADLESS=1        # 0 = показывать окно Chrome при парсинге
# OUTLOOK_AGENT_URL=http://127.0.0.1:8765
# CRM_OPEN_BROWSER=1       # автооткрытие браузера при старте
# FLASK_DEBUG=0            # 1 = debug-режим (только для разработки!)
